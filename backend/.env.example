# Copy to .env and fill in. Never commit the real .env.

# --- App ---
APP_NAME=AI Novel Assistant
DEBUG=false

# --- Database ---
# Matches docker-compose.yml. For local Postgres adjust host/credentials.
DATABASE_URL=postgresql+asyncpg://novel:novel@localhost:5433/ainovel

# --- Embedding ---
# "local" uses sentence-transformers (no API key needed).
# "openai" uses any OpenAI-compatible /embeddings endpoint.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# only used when EMBEDDING_BACKEND=openai
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=

# --- LLM (OpenAI-compatible chat completions) ---
# Any OpenAI-compatible provider works, e.g.:
#   DeepSeek:  LLM_API_BASE=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   OpenAI:    LLM_API_BASE=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=2048

# --- Retrieval ---
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.30

# --- Generation ---
RECENT_CHAPTERS_WINDOW=2
